# Default deny, including Terraform state, release plans, credentials and local data.
# deploy.sh also stages an allowlisted context and generates auth.js inside it.
**
!Dockerfile
!pyproject.toml
!uv.lock
!.dockerignore
!.gcloudignore
!idea/
!idea/**/
!idea/**/*.py
!idea/prompts/templates/*.yaml
!idea/static/css/*.css
!idea/static/html/*.html
!idea/static/js/*.js
!idea/static/img/*.svg
!idea/static/img/*.png
!idea/static/img/*.ico
