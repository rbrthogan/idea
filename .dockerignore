# Default deny: only application source and the locked build inputs enter Docker.
**
!Dockerfile
!pyproject.toml
!uv.lock
!.dockerignore
!.gcloudignore
!idea/
!idea/**/
!idea/**/*.py
!idea/prompts/templates/*.yaml
!idea/static/css/*.css
!idea/static/html/*.html
!idea/static/js/*.js
!idea/static/img/*.svg
!idea/static/img/*.png
!idea/static/img/*.ico
